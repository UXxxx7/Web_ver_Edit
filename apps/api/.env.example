# OpenMontage Web API — 环境变量示例
# ============================================================================
# 说明：变量名与代码 os.getenv(...) 逐一对齐（config.py / authored/ 各模块）。
# 服务缺 key 也能起来，但相关功能会「静默失效」（路由默默回 Arm A、AI b-roll
# 生成失败、转写走本地、编辑器链接坏）——所以**只填你实际要用的功能对应的
# key**，其余留空即可（后端都有默认兜底）。改完 .env 后**必须重启 uvicorn**
# （config 是单例，只在启动读一次）。
# ============================================================================

# ============================================================
# 核心 LLM —— 脑暴三件套 + Arm A 的 L2 规划
# ============================================================
LLM_PROVIDER=deepseek            # deepseek | openai | claude | custom
# LLM_API_KEY=                     # 通用 key；也可用下面 provider 专属的
# DEEPSEEK_API_KEY=                # LLM_PROVIDER=deepseek 时用（优先于 LLM_API_KEY）
# OPENAI_API_KEY=                  # LLM_PROVIDER=openai 时用
# LLM_BASE_URL=                    # 走自建/兼容端点时设（配合 LLM_PROVIDER=custom）
LLM_MODEL=deepseek-chat
LLM_MODEL_LONG_OUTPUT=deepseek-v4-flash   # 长输出模型；用 Gemini 端点时改成 gemini-flash-latest 之类

# ============================================================
# 脑暴 · content idea 联网搜索（web_search.py）
# ============================================================
# CONTENT_IDEA_GEMINI_KEY=         # 缺则退回「模型自身知识」，UI 会如实标注
# CONTENT_IDEA_MODEL=
CONTENT_IDEA_SEARCH_ENABLED=true

# ============================================================
# 多模态 / 视觉 —— Arm B 作者模型的回退 & 各类看图分析（qa_stills 等）
# ============================================================
# VISION_LLM_BASE_URL=
# VISION_LLM_API_KEY=              # 缺则「没有眼睛」，看图环节跳过，不影响主流程
VISION_LLM_MODEL=glm-4v-flash

# ============================================================
# Arm B 作者模型（优先于 VISION_LLM；两者都没配则 plan_authored 抛错 → 落穿回 Arm A）
# ============================================================
# AUTHOR_LLM_BASE_URL=
# AUTHOR_LLM_API_KEY=
# AUTHOR_LLM_MODEL=
# AUTHOR_LLM_RETRY_BACKOFF=        # 例：5,15,30

# ============================================================
# Arm A / Arm B 分层路由
# ============================================================
ARM_B_ENABLED=0                  # 最低优先级兜底；正常靠 /jobs 的 arm 字段选臂
ARM_B_PERCENT=100                # 灰度百分比
# ARM_ROUTER_DIR=                  # authored_config.json / authored_prefs.json 所在目录；留空=默认

# ============================================================
# Arm B · 风格参考（模仿参考视频风格）
# ============================================================
# ARM_B_STYLE_REFS=                # 是否启用风格参考
# STYLEREF_GEMINI_KEY=
# STYLEREF_GEMINI_BASE=
# STYLEREF_VIDEO_MODEL=
# STYLEREF_PREFER_NATIVE=
# STYLEREF_POINT_HALF=
# STYLEREF_MAX_VIDEO_MB=
# STYLEREF_MAX_VIDEO_S=
# STYLEREF_VIDEO_RETRY_BACKOFF=
# STYLEREF_PRICE_IN=
# STYLEREF_PRICE_OUT=

# ============================================================
# Arm B · AI 生成 b-roll
# ============================================================
ARM_B_GEN_BROLL=0                # 1 开启
ARM_B_GEN_BROLL_PROVIDER=omni    # 目前接入的生成 provider
ARM_B_GEN_BROLL_MAX=2
ARM_B_GEN_BROLL_RETRY=5,15,30
# ARM_B_STORYBOARD_NARRATIVE=
# GEMINI_API_KEY=                  # gemini/omni 视频生成（需开通 Veo/视频生成权限）
# GOOGLE_API_KEY=

# ============================================================
# 转写（Arm B 拿不到转写会落穿回 Arm A）
# ============================================================
TRANSCRIBE_PROVIDER=elevenlabs   # elevenlabs | local
# ELEVENLABS_API_KEY=              # 也是 voice-clone 用的
FASTER_WHISPER_MODEL=medium      # TRANSCRIBE_PROVIDER 非 elevenlabs 时的本地回退
# OM_FORCED_ALIGNMENT=

# apply_style 渲染（Remotion）的并发线程数，默认 1——Remotion 自己按
# os.cpus().length 猜并发数，在容器里会拿到宿主机的核数而不是实际配额，
# 小机器上白白开销内存/线程切换。有真实多核可用就调大（本地开发机可以设
# 成核数）。
REMOTION_CONCURRENCY=1

# ============================================================
# 数字人（C-roll）—— web 的 photo → /croll 已接
# ============================================================
# HEYGEN_API_KEY=

# ============================================================
# 素材库 b-roll（stock）
# ============================================================
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ============================================================
# 渲染 / 预览 / 编辑器
# ============================================================
REMOTION_PREVIEW=true
PUBLIC_BASE_URL=http://localhost:8001   # /files 下载链接、编辑器链接内嵌它；部署必改
# EDITOR_TOKEN_SECRET=                    # 不设则「打开编辑器」抛错（可回退 WHATSAPP_APP_SECRET）
# OM_EDITOR_SAVES_PER_HOUR=
# OM_RENDER_SLOTS=
# OM_RENDER_TIMEOUT_S=
# OM_TRANSCRIBE_SLOTS=
# OM_ENHANCE_SLOTS=
# OM_APPLY_STYLE_CONTENT_DEADLINE_S=

# ============================================================
# 存储 / 队列 / 运行时
# ============================================================
# STORAGE_ROOT=                    # 留空=项目内默认目录
# OPENMONTAGE_ROOT=                # 留空=仓库根
LOCAL_API_BASE=http://127.0.0.1:8001
# USE_RQ_WORKER=                   # 用 Redis/RQ 队列则设；留空=进程内后台任务
REDIS_URL=redis://localhost:6379/1
CLIP_FACTORY_ENABLED=true
CLIP_FACTORY_WALL_TIME_S=1800
SOCIAL_CAPTION_ENABLED=true

# ============================================================
# WhatsApp 专用（web 版不需要；唯一相关的是 EDITOR_TOKEN_SECRET 未设时会回退读
# WHATSAPP_APP_SECRET——直接设 EDITOR_TOKEN_SECRET 即可，不必引入这套变量）
# ============================================================
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
