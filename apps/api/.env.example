# Leave unset to run with generation endpoints returning {"script": null} /
# {"idea": null} — apps/web already handles that gracefully ("couldn't
# generate, try rephrasing"). Fill in to get real output.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Used by web_search.py's Gemini Search-grounding retrieval step. Falls
# back to no live search (model's general knowledge only, honestly labeled
# in the UI) if unset — see web_search.py's own header comment.
CONTENT_IDEA_GEMINI_KEY=
