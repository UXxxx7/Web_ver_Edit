# Leave the two Supabase vars unset to run against the local mock store
# (lib/store.ts) — no cloud account needed for local dev. Fill them in once
# a real Supabase project exists (supabase/migrations/0001_init.sql is the
# schema to apply there) and auth/data automatically switch over, no code
# changes needed (see lib/auth.ts / lib/data.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the mock-mode session cookie (lib/session.ts). Only matters while
# Supabase is unset above — set it to any long random string for anything
# beyond a throwaway local demo.
SESSION_SECRET=dev-only-insecure-secret-change-me

# Where apps/api is running.
API_BASE_URL=http://localhost:8001
